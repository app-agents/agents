{
  "name": "@app-agents/gmail",
  "version": "0.1.1",
  "description": "Gmail agent — read an inbox, decide what needs a reply, and draft the replies",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "manifest.json",
    "README.md"
  ],
  "keywords": [
    "standardagent",
    "mcp",
    "gmail",
    "google",
    "email",
    "agent"
  ],
  "license": "MIT",
  "standardagent": {
    "entryAgents": [
      "gmail_agent"
    ]
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@standardagents/anthropic": "^0.45.10",
    "@standardagents/spec": "^0.45.10",
    "zod": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/app-agents/agents.git",
    "directory": "apps/gmail"
  },
  "homepage": "https://github.com/app-agents/agents#readme",
  "bugs": {
    "url": "https://github.com/app-agents/agents/issues"
  }
}
