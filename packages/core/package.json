{
  "name": "@app-agents/core",
  "version": "0.1.0",
  "description": "Shared manifest types and registry helpers for app agents",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/app-agents/agents.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/app-agents/agents#readme",
  "bugs": {
    "url": "https://github.com/app-agents/agents/issues"
  }
}
